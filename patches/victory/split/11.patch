+/// Logs (debug) the first buffer per 4 GiB chunk with the host
+/// region kind at the chunk base and the buffer's alignment there.
+fn loose_probe(start: u64, len: u64) {
+    use windows_sys::Win32::System::Memory::{VirtualQuery, MEMORY_BASIC_INFORMATION};
+    static SEEN: Mutex<std::collections::BTreeSet<u32>> = Mutex::new(std::collections::BTreeSet::new());
+    let hi = (start >> 32) as u32;
+    {
+        let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        if !seen.insert(hi) {
+            return;
+        }
+    }
+    let base = u64::from(hi) << 32;
+    let mut info = MEMORY_BASIC_INFORMATION::default();
+    // SAFETY: a plain query of the process' own memory map.
+    let got = unsafe { VirtualQuery(base as *const _, &mut info, std::mem::size_of::<MEMORY_BASIC_INFORMATION>()) };
+    let at_base = if got == 0 {
+        "query failed".to_owned()
+    } else {
+        format!(
+            "{} {} {}",
+            if info.BaseAddress as u64 == base { "reservation-start" } else { "inside" },
+            info.State,
+            info.Type
+        )
+    };
+    tracing::debug!(
+        hi,
+        start = format_args!("{start:#x}"),
+        len,
+        chunk_base = format_args!("{base:#x}"),
+        at_base,
+        aligned = start == base,
+        "title memory starts in a chunk"
+    );
+}
