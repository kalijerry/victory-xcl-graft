+/// The title buffers that exist now, as merged `[start, end)` ranges in
+/// address order. A snapshot: buffers registered later are not in it.
+pub(crate) fn title_ranges() -> Vec<(u64, u64)> {
+    let map = buffers();
+    let mut out: Vec<(u64, u64)> = Vec::new();
+    for (&(start, _), entry) in map.iter() {
+        match out.last_mut() {
+            Some(last) if start <= last.1 => last.1 = last.1.max(entry.end),
+            _ => out.push((start, entry.end)),
+        }
+    }
+    out
+}
