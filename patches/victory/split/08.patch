+fn translate(container: &[u8], stage: &'static str) -> Result<Translated, String> {
+    // Forced (`VICTORY_XCL_FORCE`) even when we could translate it: the
+    // fallback is then the proof on shaders a short run actually reaches.
+    match crate::xcl::forced_translation(container, stage) {
+        Ok(Some(host)) => {
+            tracing::info!(
+                hash = &blake3::hash(container).to_hex()[..16],
+                "shader translated by the fallback (XCL sidecar, forced)"
+            );
+            return Ok(Translated {
+                host,
+                used: Vec::new(),
+                fallback: true,
+            });
+        }
+        Ok(None) => (),
+        Err(sidecar) => tracing::warn!(error = %sidecar, "forced sidecar unusable; trying native"),
+    }
+    match native(container) {
+        Ok(translated) => Ok(translated),
+        Err(native) => {
+            crate::xcl::dump_failed(container);
+            match crate::xcl::translated(container, stage) {
+                Ok(Some(host)) => {
+                    tracing::info!(
+                        hash = &blake3::hash(container).to_hex()[..16],
+                        "shader translated by the fallback (XCL sidecar)"
+                    );
+                    Ok(Translated {
+                        host,
+                        used: Vec::new(),
+                        fallback: true,
+                    })
+                }
+                Ok(None) => Err(native),
+                Err(sidecar) => Err(format!("{native}; sidecar: {sidecar}")),
+            }
+        }
+    }
+}
