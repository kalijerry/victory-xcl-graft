+    #[test]
+    fn io_and_the_memory_roots_follow_the_window_count() {
+        // Our own form: no window dword.
+        assert_eq!(io_dwords(0, 1), 4);
+        // The multi-window form reads `io[112]`: the buffer has room for it.
+        assert_eq!(io_dwords(0, 4), 116);
+        assert!((io_dwords(0, 4) as usize) > IO_UMA_BASE_HI);
+        assert_eq!(io_dwords(3, 4) % 4, 0);
+        assert_eq!(IO_UMA_BASE_HI, 112);
+        // `u2..` are chunks from the base, in root order, never past u5.
+        assert_eq!(window_chunks(1, 0), [0]);
+        assert_eq!(window_chunks(4, 0), [0, 1, 2, 3]);
+        assert_eq!(window_chunks(4, 13), [13, 14, 15, 16]);
+        assert_eq!(window_chunks(9, 0).len(), 4);
+    }
