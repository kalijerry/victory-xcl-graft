+    #[test]
+    fn a_sidecar_is_decoded_and_checked() {
+        let Some(fixture) = setup() else {
+            eprintln!("no samples; skipped");
+            return;
+        };
+        // A file that is not a DXIL container is refused with a clear
+        // message, then the real one decodes.
+        let sidecar = fixture
+            .dir
+            .join(format!("{}.json", blake3::hash(fixture.ps).to_hex()));
+        let dxil = std::fs::read(fixture.dir.join("ps_sample.dxil")).unwrap();
+        std::fs::write(fixture.dir.join("ps_sample.dxil"), b"BC\xc0\xde bitcode").unwrap();
+        let err = translated(fixture.ps, "pixel").unwrap_err();
+        std::fs::write(fixture.dir.join("ps_sample.dxil"), &dxil).unwrap();
+        assert!(err.contains("not a DXBC container"), "{err}");
+
+        let host = translated(fixture.ps, "pixel").unwrap().expect("the sidecar decodes");
+        assert!(host.xcl);
+        assert_eq!(host.stage, HwStage::Ps);
+        assert_eq!(host.dxil, dxil);
+
+        // Extra fields (the producer's) are ignored, and every contract
+        // field decodes: user-data entries, sampler words (the fifth,
+        // comparison one is tolerated), root views.
+        assert!(serde_json::from_slice::<Sidecar>(&std::fs::read(&sidecar).unwrap()).is_ok());
+        let full = br#"{"stage":"ps","dxil_file":"ps_sample.dxil",
+            "user_data":[{"index":4,"slot":2,"kind":"table"},
+                         {"index":5,"slot":1,"kind":"constants"}],
+            "samplers":[[1,2,3,4,1],[5,6,7,8,0]],"root_cbvs":[3,3],"root_srvs":[7]}"#;
+        std::fs::write(&sidecar, full).unwrap();
+        let host = translated(fixture.ps, "pixel")
+            .unwrap()
+            .expect("the sidecar decodes");
+        assert_eq!(host.user_data.len(), 2);
+        assert_eq!(host.user_data[0].root, RootType::Table);
+        assert_eq!(host.user_data[0].index, 4);
+        assert_eq!(host.user_data[1].root, RootType::Constants);
+        assert_eq!(host.samplers, [[1, 2, 3, 4], [5, 6, 7, 8]]);
+        assert_eq!(host.static_samplers.len(), 2);
+        assert_eq!(host.root_cbvs, [3]);
+        assert_eq!(host.root_srvs, [7]);
+
+        // The producer's own report (SGPR numbers, no root parameter) decodes as well: each one
+    // resolves through the container's root signature into slot and kind.
+    let layout = layout_of(fixture.ps, "ps");
+    let param = layout.iter().find(|p| p.sgprs > 0).expect("the sample reads user data");
+    let json = format!(
+        r#"{{"stage":"ps","dxil_file":"ps_sample.dxil","user_data":[{{"index":{}}},{{"index":{}}}],"reads_mem":true}}"#,
+        param.user_data,
+        param.user_data + 1
+    );
+    std::fs::write(&sidecar, json).unwrap();
+    let host = translated(fixture.ps, "pixel").unwrap().expect("the sidecar decodes");
+    assert_eq!(host.user_data.len(), 2, "both reported dwords resolve");
+    assert_eq!(host.user_data[0].slot, param.slot);
+    assert_eq!(host.user_data[0].root, param.root);
+    // each entry belongs to the parameter that covers its dword: index == param.user_data + dword
+    for u in &host.user_data {
+        let covered = layout
+            .iter()
+            .find(|p| p.sgprs > 0 && u32::from(p.user_data) <= u.index && u.index < u32::from(p.user_data) + p.sgprs)
+            .expect("every resolved entry is covered by a parameter");
+        assert_eq!(u.index, u32::from(covered.user_data) + u.dword);
+        assert_eq!(u.slot, covered.slot);
+    }
+    // An entry without a DXIL file is refused.
+        std::fs::write(&sidecar, br#"{"stage":"ps"}"#).unwrap();
+        assert_eq!(
+            translated(fixture.ps, "pixel"),
+            Err("no dxil_file".to_owned())
+        );
+        std::fs::write(
+            &sidecar,
+            br#"{"stage":"ps","dxil_file":"ps_sample.dxil"}"#,
+        )
+        .unwrap();
+    }
