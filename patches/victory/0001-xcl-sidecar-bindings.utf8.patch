+        assert_eq!(host.xcl_windows, 1);
+        assert_eq!(host.xcl_base_hi, 0);
+        // Both fields decode, and a count above the ABI's roots is clamped.
+        for (json, want, base) in [
+            (
+                br#"{"stage":"ps","dxil_file":"win_sample.dxil","windows":3,"uma_base_hi":13}"#
+                    .to_vec(),
+                3,
+                13,
+            ),
+            (
+                br#"{"stage":"ps","dxil_file":"win_sample.dxil","windows":9}"#.to_vec(),
+                4,
+                0,
+            ),
+            (
+                br#"{"stage":"ps","dxil_file":"win_sample.dxil","windows":0}"#.to_vec(),
+                1,
+                0,
+            ),
+        ] {
+            std::fs::write(&sidecar, &json).unwrap();
+            let host = translated_for_win(&sidecar, fixture).expect("decodes");
+            assert_eq!(host.xcl_windows, want);
+            assert_eq!(host.xcl_base_hi, base);
+        }
+    }
+
+    /// [`translated`] of a sidecar the test names itself (the fixture's own
+    /// entries are keyed by the container's hash).
+    fn translated_for_win(
+        sidecar: &Path,
+        fixture: &Fixture,
+    ) -> Result<HostShader, String> {
+        read(sidecar, fixture.dir, "pixel", fixture.ps)?.ok_or_else(|| "no entry".to_owned())
+    }
+
+    #[test]
+    fn io_and_the_memory_roots_follow_the_window_count() {
+        // Our own form: no window dword.
+        assert_eq!(io_dwords(0, 1), 4);
+        // The multi-window form reads `io[112]`: the buffer has room for it.
+        assert_eq!(io_dwords(0, 4), 116);
+        assert!((io_dwords(0, 4) as usize) > IO_UMA_BASE_HI);
+        assert_eq!(io_dwords(3, 4) % 4, 0);
+        assert_eq!(IO_UMA_BASE_HI, 112);
+        // `u2..` are chunks from the base, in root order, never past u5.
+        assert_eq!(window_chunks(1, 0), [0]);
+        assert_eq!(window_chunks(4, 0), [0, 1, 2, 3]);
+        assert_eq!(window_chunks(4, 13), [13, 14, 15, 16]);
+        assert_eq!(window_chunks(9, 0).len(), 4);
+    }
+
+    #[test]
+    #[cfg(windows)]
+    fn a_sidecar_shader_makes_a_host_pipeline() {
+        let Some(fixture) = setup() else {
+            eprintln!("no samples; skipped");
+            return;
+        };
+        let host = translated(fixture.vs, "vertex")
+            .unwrap()
+            .expect("the sidecar decodes");
+        let device = match victory_shader::emit::host::Host::new(true) {
+            Ok(device) => device,
+            Err(e) => {
+                eprintln!("no WARP device ({e}); skipped");
+                return;
+            }
+        };
+        let ps = victory_shader::emit::host::stub_ps();
+        if let Err(e) = device.pipeline(&host, &ps) {
+            panic!("pipeline refused: {e}");
+        }
+    }
+}
