diff --git a/apps/victory/examples/xclgrab.rs b/apps/victory/examples/xclgrab.rs
new file mode 100644
index 0000000..689293d
--- /dev/null
+++ b/apps/victory/examples/xclgrab.rs
@@ -0,0 +1,92 @@
+//! Throwaway: copy the shader containers of a file whose content hash is
+//! wanted (as the title would pass them). `xclgrab <file> <hash list> <out dir>`.
+//!
+//! Containers sit in SGD5 records (optionally compressed) or stand as is;
+//! both are found here as `victory translate` finds them.
+
+use std::borrow::Cow;
+
+use victory_game::sgd5;
+use victory_shader::Container;
+
+enum Source<'a> {
+    Raw { data: &'a [u8] },
+    Packed(sgd5::Record<'a>),
+}
+
+impl Source<'_> {
+    fn bytes(&self) -> Option<Cow<'_, [u8]>> {
+        match self {
+            Source::Raw { data } => Some(Cow::Borrowed(data)),
+            Source::Packed(r) => r.unpack().map(Cow::Owned),
+        }
+    }
+}
+
+fn sources(data: &[u8]) -> Vec<Source<'_>> {
+    let mut out = Vec::new();
+    if sgd5::is_sgd5(data) {
+        out.extend(sgd5::records(data).map(Source::Packed));
+    }
+    out.extend(
+        memchr::memmem::find_iter(data, b"DXBC")
+            .filter(|&offset| Container::parse(&data[offset..]).is_ok())
+            .map(|offset| Source::Raw {
+                data: &data[offset..],
+            }),
+    );
+    out
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.first().map(String::as_str) == Some("--at") {
+        let data = std::fs::read(&args[1]).expect("read the file");
+        let at: usize = args[2].parse().expect("offset");
+        for r in sgd5::records(&data) {
+            if r.offset == at {
+                let bytes = r.unpack().expect("unpack");
+                println!(
+                    "record {} name={:?} unpacked={} hash={}",
+                    r.offset,
+                    r.name,
+                    bytes.len(),
+                    blake3::hash(&bytes).to_hex()
+                );
+                return;
+            }
+        }
+        eprintln!("no record at {at:#x}");
+        return;
+    }
+    if args.len() < 3 {
+        eprintln!("usage: xclgrab <file> <hash list> <out dir>");
+        std::process::exit(2);
+    }
+    let data = std::fs::read(&args[0]).expect("read the file");
+    let wanted = std::fs::read_to_string(&args[1]).expect("read the hash list");
+    // Lines are `stage hash error`; take the hash.
+    let wanted: Vec<&str> = wanted
+        .lines()
+        .filter_map(|l| l.split_whitespace().nth(1))
+        .collect();
+    let out = std::path::Path::new(&args[2]);
+    std::fs::create_dir_all(out).expect("make the output directory");
+    let (mut found, mut parsed) = (0, 0);
+    for source in sources(&data) {
+        let Some(bytes) = source.bytes() else {
+            continue;
+        };
+        if Container::parse(&bytes).is_err() {
+            continue;
+        }
+        parsed += 1;
+        let hash = blake3::hash(&bytes).to_hex();
+        if wanted.iter().any(|w| hash.starts_with(w)) {
+            found += 1;
+            std::fs::write(out.join(format!("{hash}.bin")), &bytes).expect("write");
+            println!("{hash} {}", bytes.len());
+        }
+    }
+    eprintln!("{parsed} containers parsed, {found} wanted");
+}
