@@ -0,0 +1,77 @@
+//! Translate one console shader container with XCL's translator, the way
+//! the graft's sidecar needs it: DXIL out, the stage's static samplers as
+//! the JSON line `xcl dxil` prints.
+//!
+//! `cargo run -p xtask --example xcl-shader -- <container> <out.dxil> [split]`
+//!
+//! `split` (0/1, default 1) is `split_wave64`: a wave64 console compute
+//! program is emitted as two wave32 halves for a device that runs only
+//! 32-lane waves. That is every PC GPU in reach here (WARP and the RTX
+//! 3080 report `WaveLaneCountMax` 32), and without it D3D12 refuses every
+//! compute pipeline built from the DXIL (`[WaveSize(64)]`).
+//!
+//! Requires `XCL_DXC_DIR` to name the folder of `dxcompiler.dll` /
+//! `dxil.dll` as `xcl dxil` does.
+
+use std::path::Path;
+
+use xcl::gpu::recomp::pso::{console_to_dxil_for, Stage};
+use xcl::gpu::xbox;
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.len() < 2 {
+        eprintln!("usage: xcl-shader <container> <out.dxil> [split]");
+        std::process::exit(2);
+    }
+    let (input, out) = (Path::new(&args[0]), Path::new(&args[1]));
+    let split = args.get(2).is_none_or(|s| s != "0");
+    let data = std::fs::read(input).expect("read the container");
+    let stage = if xcl::gpu::recomp::pso::fspx(&data).is_some() {
+        Stage::Compute
+    } else {
+        let Some(sh) = xbox::parse(&data) else {
+            eprintln!("{}: not a console shader container", input.display());
+            std::process::exit(2);
+        };
+        let hw = sh
+            .fssm
+            .iter()
+            .filter_map(|f| f.stages.first().map(|s| s.hw))
+            .find(|hw| matches!(hw, 4 | 5 | 6));
+        match hw {
+            Some(4) => Stage::Vertex,
+            Some(5) => Stage::Pixel,
+            Some(6) => Stage::Compute,
+            _ => {
+                eprintln!("{}: no VS, PS or CS variant", input.display());
+                std::process::exit(2);
+            }
+        }
+    };
+    match console_to_dxil_for(&data, stage, 0, split) {
+        Ok(c) => {
+            std::fs::write(out, &c.dxil).expect("write the DXIL");
+            let samplers: Vec<String> = c
+                .samplers
+                .iter()
+                .map(|(w, cmp)| format!("[{},{},{},{},{}]", w[0], w[1], w[2], w[3], *cmp as u8))
+                .collect();
+            println!(
+                "{{\"stage\":\"{}\",\"dxil\":\"{}\",\"bytes\":{},\"samplers\":[{}]}}",
+                match stage {
+                    Stage::Vertex => "vs",
+                    Stage::Pixel => "ps",
+                    Stage::Compute => "cs",
+                },
+                out.to_string_lossy().replace('\\', "/"),
+                c.dxil.len(),
+                samplers.join(",")
+            );
+        }
+        Err(e) => {
+            eprintln!("{}: {e}", input.display());
+            std::process::exit(1);
+        }
+    }
+}
